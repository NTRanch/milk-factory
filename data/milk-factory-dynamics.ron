// torogao-milkfactory-dynamics/1 — measured tuning constants for
// the Milk Factory remake, transcribed from the clean-room RE
// record (~/workspace/nsfw-remakes-20261108/games/
// milk-factory-dynamics.md; extraction: ikdasm export of the
// v1.22 build's Assembly-CSharp.dll, primo
// ~/.local/share/pax/milk-factory-20261108/assembly-csharp.il,
// sha256 41859555ffc892dac565e636cfc2a0b84ef1a7642f103585f1931bf0f0ae8ada,
// byte-identical across two ikdasm runs).
//
// Every value below is a static-IL measurement or a value the
// spec marks DERIVED with its derivation shown. Values the spec
// marks UNKNOWN/REVIEW (§10: camera zoom limits, animation clip
// data, appearance-editor verb-to-price wiring, star cap) are
// deliberately ABSENT — the loader refuses fields outside this
// schema, so an unmeasured value cannot be smuggled in as data.
//
// Roster scope: REDUCED FIRST (Owner ruling D-1104). The spec's
// measured roster is 18 girls (§7); this file carries girls
// 1..=4 only. Adding a girl is a data-only change: append her
// measured §7 row (her index must continue the sequence).
//
// Rolled stats (cs1/cs3/cs5) are Random.Range rolls in the
// original, persisted after the first run (dynamics §7). The
// remake is deterministic (animation note §7), so each rolled
// stat below is ONE fixed value inside the measured range,
// recorded here as the roster's canonical roll:
//   girl 1: cs1 80 in [70,90),  cs3 70 in [60,80),  cs5 9 in [7,12)
//   girl 2: cs1 90 in [80,100), cs3 60 in [50,70),  cs5 9 in [7,12)
//   girl 3: cs1 90 in [80,100), cs3 70 in [60,80),  cs5 11 in [9,14)
//   girl 4: cs1 100 in [90,110), cs3 80 in [70,90), cs5 13 in [11,16)
// Girl 2's cs5 range is REVIEW in the spec (§10 item 3: its IL
// constants could not be separated from girl 1's [7,12) with
// certainty); the value 9 sits inside [7,12) under either read,
// so the reduced roster does not depend on the open question.
(
    // Account new-game defaults (dynamics §2; gamectrl::Start
    // new-game branch sets coin/max XP threshold/keys and leaves
    // level and XP at their field default of 0 — verified in the
    // IL extract m-gamectrl.txt, IL_0191..IL_01b2).
    starting_coin: 5000.0,
    starting_keys: 0,
    account_level_start: 0,
    xp_threshold_start: 100.0,
    // Level rule (dynamics §4): on XP >= threshold, level += 1,
    // threshold += 100, XP := 0 (overflow discarded, one level
    // per session-end check).
    xp_threshold_step: 100.0,
    // Production cycle (dynamics §3): stamina drain while
    // producing is a bare literal, the same for every girl.
    stamina_drain_per_second: 5.0,
    // A fresh girl's stamina at first run (girliamge::Start),
    // regardless of her cs1.
    fresh_girl_stamina: 50.0,
    // Battle loop (dynamics §5, chiendau::Start defaults).
    battle_damage_start: 10.0,
    battle_level_start: 1,
    battle_upgrade_cost_start: 200.0,
    battle_max_hp_start: 50.0,
    // On a kill (hp < 0, strictly): battle level += 1,
    // max HP += 10, HP := max HP, pending reward += 100.
    battle_kill_max_hp_step: 10.0,
    battle_kill_reward: 100.0,
    // Damage upgrade: damage += 10, cost += 100 per purchase.
    battle_damage_step: 10.0,
    battle_upgrade_cost_step: 100.0,
    // Enemy portrait swap: Random.Range(1, 20) reaches indices
    // 1..=19 of a 20-portrait set; branch 20 is unreachable as
    // shipped (dynamics §5) and stays unreachable here.
    enemy_portrait_count: 20,
    enemy_index_reachable_max: 19,
    // Stat upgrades (dynamics §7): per-purchase increments for
    // (cs1, cs2, cs3, cs4, cs5), and the per-purchase cost
    // growth 80 + 20 * girl_index, identical for all five stats.
    stat_upgrade_increments: (10.0, 0.2, 10.0, 0.1, 5.0),
    upgrade_cost_growth_base: 80.0,
    upgrade_cost_growth_per_index: 20.0,
    // Star upgrade (dynamics §7): flat key cost, flat stat
    // bonuses (cs1, cs2, cs3, cs4, cs5). No star cap exists in
    // the IL; a cap would be UI-side and is REVIEW (§10 item
    // 6), so none is asserted here.
    star_upgrade_key_cost: 3,
    star_upgrade_bonuses: (50.0, 1.0, 50.0, 0.5, 25.0),
    // Fixed-step seed for the enemy portrait draw. The original
    // uses unseeded UnityEngine.Random (animation note §7); the
    // remake seeds the draw so runs are reproducible.
    enemy_draw_seed: 88172645463325252,
    // The reduced roster (dynamics §2 room prices, §7 stats).
    // Names are estate-original placeholders (S5 content is
    // Owner-gated); the original's girls are unnamed in code.
    girls: [
        (
            index: 1,
            name: "Girl 01",
            room_price: 500.0,
            cs1: 80.0,
            cs2: 2.1,
            cs3: 70.0,
            cs4: 1.1,
            cs5: 9.0,
            upgrade_cost_start: 100.0,
        ),
        (
            index: 2,
            name: "Girl 02",
            room_price: 700.0,
            cs1: 90.0,
            cs2: 2.0,
            cs3: 60.0,
            cs4: 1.0,
            cs5: 9.0,
            upgrade_cost_start: 110.0,
        ),
        (
            index: 3,
            name: "Girl 03",
            room_price: 900.0,
            cs1: 90.0,
            cs2: 2.2,
            cs3: 70.0,
            cs4: 1.2,
            cs5: 11.0,
            upgrade_cost_start: 120.0,
        ),
        (
            index: 4,
            name: "Girl 04",
            room_price: 1100.0,
            cs1: 100.0,
            cs2: 2.3,
            cs3: 80.0,
            cs4: 1.3,
            cs5: 13.0,
            upgrade_cost_start: 130.0,
        ),
    ],
    // Milestone board (dynamics §6, nhanquan): ten one-shot
    // claims gated on account level 5, 10, ..., 50, alternating
    // coin and key rewards. Totals: 32000 coin + 75 keys.
    milestones: [
        (gate_level: 5, reward: Coin(1000.0)),
        (gate_level: 10, reward: Keys(5)),
        (gate_level: 15, reward: Coin(3000.0)),
        (gate_level: 20, reward: Keys(10)),
        (gate_level: 25, reward: Coin(5000.0)),
        (gate_level: 30, reward: Keys(15)),
        (gate_level: 35, reward: Coin(8000.0)),
        (gate_level: 40, reward: Keys(20)),
        (gate_level: 45, reward: Coin(15000.0)),
        (gate_level: 50, reward: Keys(25)),
    ],
)
